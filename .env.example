# ─────────────────────────────────────────────────────────────────────
#  Mnémosyne — tout est facultatif : la configuration complète se fait
#  dans le panneau web. Ce fichier sert surtout aux serveurs et à Docker.
# ─────────────────────────────────────────────────────────────────────

# Token du bot (Developer Portal > Bot > Reset Token).
# Laisse vide pour le saisir depuis le panneau web.
DISCORD_TOKEN=

# Identifiant de l'application. Détecté automatiquement à partir du token.
CLIENT_ID=

# Port et adresse d'écoute du panneau web.
# WEB_PORT=8787   (sur Pterodactyl, laisse commenté : le port alloué est utilisé)
WEB_HOST=0.0.0.0

# Adresse publique du panneau, utilisée dans les liens envoyés sur Discord.
# En local : http://localhost:8787 — sur un serveur : https://mnemo.exemple.fr
PUBLIC_URL=http://localhost:8787

# Dossier des données (configuration, jeton PRONOTE, horaires de transport).
# DATA_DIR=./data
