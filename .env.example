# Mnémosyne (bot) : modèle commun des .env Salks.
# En local : ce fichier. Sur Cloudflare : mêmes clés dans Settings > Variables and Secrets
# (les NEXT_PUBLIC_* doivent aussi être définies pour le build).

# --- Commun aux bots Salks. ---
# Olympe, l'API centrale
OLYMPE_URL=https://olympe.salks.fr
# Identifiant du bot dans Olympe
OLYMPE_BOT_ID=mnemosyne-bot
# Créé dans Olympe > Sites > mnemosyne-bot > Créer le jeton (affiché une seule fois)
OLYMPE_BOT_TOKEN=

# --- Propre au bot ---
# Token du bot (ou à saisir dans le panneau)
DISCORD_TOKEN=
# Détecté depuis le token si vide
CLIENT_ID=
# Adresse d'écoute du panneau
WEB_HOST=0.0.0.0
# Port du panneau (laisser vide sur Pterodactyl)
WEB_PORT=8787
# Adresse publique du panneau
PUBLIC_URL=http://localhost:8787
